# Copy to .env and fill in. .env is gitignored.

# LLM for answers + the RAGAS eval. Default provider is Gemini (FREE, no card).
# Get a free key at https://aistudio.google.com  ->  "Get API key".
GEMINI_API_KEY=...

# Alternative providers — set REPOSAGE_LLM_PROVIDER to switch (gemini|anthropic):
# ANTHROPIC_API_KEY=sk-ant-...     # needs paid credit at console.anthropic.com

# --- optional overrides (sensible defaults exist) ---
# REPOSAGE_DENSE_MODEL=BAAI/bge-small-en-v1.5     # or BAAI/bge-code-v1 for SOTA code retrieval
# REPOSAGE_QDRANT_URL=http://localhost:6333        # set to use a Qdrant server instead of local disk
# REPOSAGE_MAX_CHUNK_CHARS=1500
# REPOSAGE_ANTHROPIC_MODEL=claude-haiku-4-5
